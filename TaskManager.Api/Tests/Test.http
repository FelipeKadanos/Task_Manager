# Testes manuais: extensão REST Client do VS Code.
# EXECUTE NA ORDEM.

# Os IDs são capturados das respostas. Os registros são excluídos ao final.
# Troque execucao se uma execução anterior foi interrompida.


@baseUrl = http://localhost:5000
@execucao = teste-001

### Raiz - esperado: 200
GET {{baseUrl}}/

### Cadastrar projeto - esperado: 201
# @name projeto
POST {{baseUrl}}/api/projetos
Content-Type: application/json

{"nome":"projeto {{execucao}}"}

### Cadastrar outroProjeto - esperado: 201
# @name outroProjeto
POST {{baseUrl}}/api/projetos
Content-Type: application/json

{"nome":"outroProjeto {{execucao}}"}

### Cadastrar categoria - esperado: 201
# @name categoria
POST {{baseUrl}}/api/categorias
Content-Type: application/json

{"nome":"categoria {{execucao}}"}

### Resumo vazio - esperado: todas as contagens e percentual zero
GET {{baseUrl}}/api/projetos/{{projeto.response.body.$.id}}/resumo

### Alterar projeto - esperado: 200
PUT {{baseUrl}}/api/projetos
Content-Type: application/json

{"id":{{projeto.response.body.$.id}},"nome":"projeto atualizado {{execucao}}"}

### Conferir nome atualizado - esperado: 200
GET {{baseUrl}}/api/projetos/{{projeto.response.body.$.id}}

### Listar projetos - esperado: 200
GET {{baseUrl}}/api/projetos

### Alterar categoria - esperado: 200
PUT {{baseUrl}}/api/categorias
Content-Type: application/json

{"id":{{categoria.response.body.$.id}},"nome":"categoria atualizado {{execucao}}"}

### Conferir nome atualizado - esperado: 200
GET {{baseUrl}}/api/categorias/{{categoria.response.body.$.id}}

### Listar categorias - esperado: 200
GET {{baseUrl}}/api/categorias

### Cadastrar tarefa - esperado: 201
# @name tarefa
POST {{baseUrl}}/api/tarefas
Content-Type: application/json

{
    "titulo": "tarefa {{execucao}}",
    "descricao": "Descrição de teste",
    "status": 0,
    "prioridade": 0,
    "criacao": "2026-10-25T10:00:00",
    "vencimento": "2026-11-01",
    "categoriaId": {{categoria.response.body.$.id}},
    "projetoId": {{projeto.response.body.$.id}}
}

